{
  "name": "skiplink",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check . && pnpm -r lint",
    "lint:fix": "biome check --write . && pnpm -r lint:fix",
    "db:generate": "pnpm --filter @skiplink/server db:generate",
    "db:migrate": "pnpm --filter @skiplink/server db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "typescript": "^5.7.2"
  }
}
