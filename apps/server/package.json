{
  "name": "@tabwalk/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts api",
    "dev:worker": "tsx watch src/index.ts worker",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.2",
    "axe-core": "^4.10.2",
    "drizzle-orm": "^0.38.2",
    "hono": "^4.6.14",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
