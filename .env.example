# Copy to .env:  cp .env.example .env   (Windows: copy .env.example .env)

# Postgres holds both the data and the job queue. No Redis needed.
POSTGRES_USER=tabwalk
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=tabwalk
DATABASE_URL=postgres://tabwalk:change-me-in-production@db:5432/tabwalk

# API
PORT=3000

# Scanner
# Maximum pages crawled per scan
MAX_PAGES_PER_SCAN=50
# Browser tabs open at once. Each one costs 300-500 MB.
# On a 2 GB server set this to 2.
SCAN_CONCURRENCY=3
# Per-page load timeout, milliseconds
PAGE_TIMEOUT_MS=30000
# Path to your own Chromium, if the bundled binary will not start.
# CHROMIUM_EXECUTABLE=/usr/bin/chromium

# Address people use to open the dashboard, e.g. https://a11y.example.com.
# Makes the sign-in cookie Secure and is used for links in notifications
# and for single sign-on.
# PUBLIC_URL=

# API base URL used at frontend build time
VITE_API_URL=/api

# Image version for docker-compose.yml, e.g. 0.1.0
# TABWALK_VERSION=latest
